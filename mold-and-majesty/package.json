{
  "name": "mold-and-majesty",
  "version": "0.1.0",
  "private": true,
  "description": "Jeu de gestion en pixel art : un réseau de mycélium bâtit un royaume dans une forêt, vue en coupe 2D.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@fontsource/tiny5": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  }
}
